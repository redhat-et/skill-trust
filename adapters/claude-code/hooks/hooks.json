{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_OPTION_BINARY:-skill-trust}\" hook claude-code session-start",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_OPTION_BINARY:-skill-trust}\" hook claude-code pre-tool-use",
            "timeout": 30,
            "onFailure": "block"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_OPTION_BINARY:-skill-trust}\" hook claude-code user-prompt-submit",
            "timeout": 30,
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
