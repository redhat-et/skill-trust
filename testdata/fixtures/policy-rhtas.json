{
  "apiVersion": "skill-trust.policy/v1",
  "name": "cross-root-rhtas",
  "trustRoots": {
    "rhtas": {"type": "trusted-root", "path": "rhtas-trusted-root.json"}
  },
  "signers": [
    {
      "name": "e2e-workflow",
      "mode": "keyless",
      "certificate": {
        "identities": ["https://github.com/redhat-et/skill-trust/.github/workflows/e2e-sign.yml@refs/heads/main"],
        "issuer": "https://token.actions.githubusercontent.com"
      },
      "provenance": {"sourceRepository": "redhat-et/skill-trust"},
      "trustRoot": "rhtas",
      "requireTransparencyLog": true
    }
  ]
}
