  "apiVersion": "skill-trust.policy/v1",
  "name": "cross-root-public",
  "trustRoots": {
    "sigstore": {"type": "sigstore-public"}
  },
  "signers": [
    {
      "name": "e2e-workflow",
      "mode": "keyless",
